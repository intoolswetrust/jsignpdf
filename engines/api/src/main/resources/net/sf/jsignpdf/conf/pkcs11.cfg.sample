# Sample PKCS#11 profile for JSignPdf.
# Lines starting with #jsignpdf: are JSignPdf metadata; SunPKCS11 treats them as comments.
#   label    - name shown in the keystore list
#   provider - sun (default), jsign or both

# Look for the full list of possible attributes at
# https://docs.oracle.com/en/java/javase/21/security/pkcs11-reference-guide1.html

#jsignpdf:label=My token
#jsignpdf:provider=sun
name=JSignPdf

library=/usr/lib/libeToken.so
slotListIndex=0
