#!/bin/sh
DIR=/app/share/jsignpdf
JAVA=/app/jre/bin/java
JAVA_OPTS="--add-exports jdk.crypto.cryptoki/sun.security.pkcs11.wrapper=ALL-UNNAMED --add-opens java.base/java.security=ALL-UNNAMED"
# Font antialiasing
exec "$JAVA" $JAVA_OPTS "-Djsignpdf.home=$DIR" "-Dawt.useSystemAAFontSettings=lcd" "-Dswing.aatext=true" -cp "$DIR/lib/*" com.intoolswetrust.jsignpdf.Bootstrap "$@"
